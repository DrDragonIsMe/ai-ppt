{
  "name": "ai-ppt-skills",
  "version": "2.8.1",
  "description": "Personal knowledge hub + HTML slide engine: notes/fragments knowledge base, AI-generated decks from URL/article/notes, with Claude Code / Kimi CLI skills (个人知识中枢：双链笔记知识库 + AI 生成 HTML 幻灯片).",
  "bin": {
    "ai-ppt-skills": "./install-skills.js"
  },
  "scripts": {
    "install-skills": "node install-skills.js",
    "postinstall": "node install-skills.js",
    "intro": "node install-skills.js --guide",
    "upgrade-decks": "node scripts/upgrade-decks.mjs",
    "web": "node server.mjs",
    "generate": "node scripts/generate-deck.mjs",
    "design-lint": "node scripts/design-lint.mjs",
    "export-pptx": "node scripts/export-pptx.mjs",
    "export-pptx-image": "node scripts/export-pptx.mjs --image",
    "export-pdf": "node scripts/export-pdf.mjs",
    "export-video": "node scripts/export-video.mjs",
    "backup": "node scripts/backup.mjs",
    "search": "node scripts/search.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "chat-modify": "node scripts/chat-modify.mjs",
    "test": "node --test tests/core.test.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "wuying": "bash scripts/wuying.sh",
    "wuying:start": "bash scripts/wuying.sh start",
    "wuying:stop": "bash scripts/wuying.sh stop",
    "wuying:status": "bash scripts/wuying.sh status",
    "wuying:reboot": "bash scripts/wuying.sh reboot",
    "wuying:list": "bash scripts/wuying.sh list",
    "wuying:configure": "bash scripts/wuying.sh configure"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cheerio": "^1.0.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^3.12.0",
    "puppeteer": "^25.3.0",
    "puppeteer-core": "^23.0.0",
    "qrcode": "^1.5.4"
  },
  "files": [
    "skills/",
    "install-skills.js",
    "install-skills.sh",
    "ai-ppt-base/",
    "templates/",
    "web/",
    "server.mjs",
    "scripts/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "MEMORY.md"
  ],
  "keywords": [
    "ppt",
    "slides",
    "html",
    "claude-cli",
    "kimi-cli",
    "skills",
    "knowledge-base",
    "notes",
    "llm",
    "ai",
    "presentation",
    "slides-generator"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:DrDragonIsMe/ai-ppt.git"
  },
  "bugs": {
    "url": "https://github.com/DrDragonIsMe/ai-ppt/issues"
  }
}
