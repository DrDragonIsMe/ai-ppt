# 无影云电脑凭证配置示例
# 复制此文件为 .wuying.env 并填入真实值
# 注意: .wuying.env 已被 gitignore，不会提交到仓库

# RAM 子账号 AccessKey（需授权 AliyunECDFullAccess）
WUYING_ACCESS_KEY_ID=your-access-key-id
WUYING_ACCESS_KEY_SECRET=your-access-key-secret

# 区域（默认 cn-hangzhou）
WUYING_REGION=cn-hangzhou

# 云电脑 ID（运行 npm run wuying:list 获取）
WUYING_DESKTOP_ID=ecd-xxxxxxxx